# Runtime
NODE_ENV=development
PORT=3001

# JWT
# production requires a unique secret of at least 32 characters; this placeholder is rejected there
JWT_SECRET=your-jwt-secret-key-here

# Server
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Database (optional; tests override this with :memory:)
# DATABASE_PATH=./database.sqlite

# Admin Seed Data (development defaults, publicly documented)
# NODE_ENV=production refuses to start with the default password or one shorter than 12 characters
ADMIN_EMAIL=admin@hexschool.com
ADMIN_PASSWORD=12345678

# ECPay (the values below are ECPay's public staging test credentials)
# NODE_ENV=production requires ECPAY_ENV to be set explicitly, and ECPAY_ENV=production
# requires your own merchant credentials instead of these test values
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs
ECPAY_ENV=staging

# Playwright E2E (optional overrides; target server must already be running)
# E2E_BASE_URL=http://localhost:3001
# E2E_ADMIN_EMAIL=admin@hexschool.com
# E2E_ADMIN_PASSWORD=12345678
# PLAYWRIGHT_CHANNEL=chrome
# PLAYWRIGHT_HEADLESS=true
